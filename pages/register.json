{
  "title": "Register",
  "path": "/register",
  "elements": {
    "register-header": {
      "type": "js.header",
      "props": {
        "backgroundColor": "chalk"
      },
      "slots": {
        "branding": ["register-header-logo"],
        "navigation": ["register-navigation"]
      }
    },
    "register-header-logo": {
      "type": "js.logo",
      "props": {
        "linkToFrontPage": true
      }
    },
    "register-navigation": {
      "type": "js.navigation",
      "props": {
        "activeUrl": "/page/register"
      }
    },
    "register-section": {
      "type": "js.section",
      "props": {
        "backgroundColor": "paper"
      },
      "slots": {
        "content": [
          "register-eyebrow",
          "register-heading",
          "register-paragraph"
        ]
      }
    },
    "register-eyebrow": {
      "type": "js.paragraph",
      "props": {
        "text": "Register",
        "variant": "eyebrow"
      }
    },
    "register-heading": {
      "type": "js.heading",
      "props": {
        "text": "Build your hybrid team."
      }
    },
    "register-paragraph": {
      "type": "js.paragraph",
      "props": {
        "text": "<p>Use this page as the starting point for a new Humanify account or team inquiry workflow.</p>"
      }
    },
    "register-footer": {
      "type": "js.footer",
      "props": {
        "backgroundColor": "ink",
        "copyrightNotice": "&copy; 2025-2026 Humanify Example Ventures Inc.",
        "linkedInUrl": "https://www.linkedin.com",
        "xUrl": "https://x.com",
        "emailUrl": "mailto:hello@example.com"
      },
      "slots": {
        "branding": ["register-footer-logo"]
      }
    },
    "register-footer-logo": {
      "type": "js.logo",
      "props": {
        "linkToFrontPage": false
      }
    }
  }
}
