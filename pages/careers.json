{
  "title": "Careers",
  "path": "/careers",
  "elements": {
    "careers-header": {
      "type": "js.header",
      "props": {
        "backgroundColor": "chalk"
      },
      "slots": {
        "branding": ["careers-header-logo"],
        "navigation": ["careers-navigation"]
      }
    },
    "careers-header-logo": {
      "type": "js.logo",
      "props": {
        "linkToFrontPage": true
      }
    },
    "careers-navigation": {
      "type": "js.navigation",
      "props": {
        "activeUrl": "/page/careers"
      }
    },
    "careers-section": {
      "type": "js.section",
      "props": {
        "backgroundColor": "paper"
      },
      "slots": {
        "content": ["careers-eyebrow", "careers-heading", "careers-paragraph"]
      }
    },
    "careers-eyebrow": {
      "type": "js.paragraph",
      "props": {
        "text": "Careers",
        "variant": "eyebrow"
      }
    },
    "careers-heading": {
      "type": "js.heading",
      "props": {
        "text": "Help teams make AI-assisted work more human."
      }
    },
    "careers-paragraph": {
      "type": "js.paragraph",
      "props": {
        "text": "<p>We look for editors, strategists, designers, and communicators who can turn fast machine output into work people trust.</p>"
      }
    },
    "careers-footer": {
      "type": "js.footer",
      "props": {
        "backgroundColor": "ink",
        "copyrightNotice": "&copy; 2025-2026 Humanify Example Ventures Inc.",
        "linkedInUrl": "https://www.linkedin.com",
        "xUrl": "https://x.com",
        "emailUrl": "mailto:hello@example.com"
      },
      "slots": {
        "branding": ["careers-footer-logo"]
      }
    },
    "careers-footer-logo": {
      "type": "js.logo",
      "props": {
        "linkToFrontPage": false
      }
    }
  }
}
