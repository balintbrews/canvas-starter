        "testimonial-in-section-item-2": {
          "type": "testimonial-item",
          "props": {
            "quote": "<p>We kept our tools, our people, and our pace. What changed was confidence: every brief now comes back with a clear point of view, and every draft leaves with a reason it works.</p>",
            "name": "Tobias Ekwueme",
            "role": "VP Brand, Halvard Robotics",
