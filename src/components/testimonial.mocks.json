              "height": 1024
            }
          }
        },
        "testimonial-in-section-item-3": {
          "type": "testimonial-item",
          "props": {
            "quote": "<p>The insight synthesis alone paid for the Growth plan. Model output, research, and our notes came back as three decisions, not thirty pages. Leadership meetings got shorter and better.</p>",
