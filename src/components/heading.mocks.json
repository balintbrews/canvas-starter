{
  "mocks": [
    {
      "name": "Heading in a section",
      "root": "heading-in-a-section",
      "elements": {
        "heading-in-a-section": {
          "type": "section",
          "props": {
            "backgroundColor": "chalk"
          },
          "slots": {
            "content": ["heading-default"]
          }
        },
        "heading-default": {
          "type": "heading",
          "props": {
            "text": "We bring human strengths to AI-first teams."
          }
        }
      }
    },
    {
      "name": "Page title (h1)",
      "root": "heading-title-section",
      "elements": {
        "heading-title-section": {
          "type": "section",
          "props": {
            "backgroundColor": "paper"
          },
          "slots": {
            "content": ["heading-title-eyebrow", "heading-title"]
          }
        },
        "heading-title-eyebrow": {
          "type": "paragraph",
          "props": {
            "text": "Article",
            "variant": "eyebrow"
          }
        },
        "heading-title": {
          "type": "heading",
          "props": {
            "text": "How to turn model output into product stories people remember",
            "level": "h1"
          }
        }
      }
    }
  ]
}
